# 노션 관련
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_CATEGORY_DATABASE_ID=

# 사이드바 프로필 카드에 표시할 GitHub 계정 (api.github.com/users/<이거> 조회).
GITHUB_USERNAME=

# https://github.com/settings/tokens?type=beta 에서 Fine-grained token 생성,
# Public Repositories만 read-only로 줘도 충분함(계정 전체 권한 불필요).
GITHUB_TOKEN=


# 배포 후 도메인이 정해지면 채울 것 (sitemap.xml, robots.txt, OG 태그의 절대경로 계산에 쓰임).
# 안 채우면 http://localhost:3000으로 대체됨.
NEXT_PUBLIC_SITE_URL=

# 로컬 개발 중인 .NET 백엔드(backend/) 주소. 조회수 등 백엔드 연동에 사용.
# 안 채우면 http://localhost:5145로 대체됨(backend/Properties/launchSettings.json의 http 프로필 포트와 일치).
BACKEND_API_URL=

# 검색(Meilisearch). 홈서버 컨테이너(deploy/meilisearch)에 SSH 터널로 접근:
#   ssh -L 17700:localhost:17700 homeserver
# API 키는 홈서버의 secret/meilisearch/.env(MEILI_MASTER_KEY) 값과 동일하게 맞출 것.
# 안 채우면 http://localhost:17700으로 대체됨.
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# 재인덱싱 API(/api/search/reindex) 호출 시 x-reindex-secret 헤더로 넘길 임의의 값.
# 아무나 재인덱싱을 트리거하지 못하게 막는 용도라 값 자체의 의미는 없음.
REINDEX_SECRET=

# 댓글(giscus, GitHub Discussions 기반). 클라이언트에서 그대로 쓰는 값들이라
# 비밀값 아님(NEXT_PUBLIC_ 접두사로 번들에 포함돼도 문제 없음) — 어차피 giscus
# 위젯 자체가 이 값들을 페이지 data-attribute로 노출함. 준비 순서:
#   1) 레포 Settings > General > Features에서 Discussions 켜기
#   2) https://github.com/apps/giscus 에서 이 레포에 giscus 앱 설치
#   3) 레포 Discussions 탭에서 댓글용 카테고리 만들기(예: "Comments", Announcement 타입 권장 —
#      방문자가 새 토론을 직접 못 만들게)
#   4) https://giscus.app 에서 레포 입력 → 아래 4개 값이 자동 생성됨, 그대로 복붙
NEXT_PUBLIC_GISCUS_REPO= # ID/repo
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
